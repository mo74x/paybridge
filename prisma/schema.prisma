generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum GatewayProvider {
  PAYMOB
  FAWRY
  STRIPE
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Merchant {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  email           String          @unique
  webhookUrl      String?         // Per-merchant outbound webhook URL
  webhookSecret   String?         // Per-merchant HMAC signing secret
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  apiKeys         ApiKey[]
  paymentIntents  PaymentIntent[]
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  merchantId  String    @db.Uuid
  keyHash     String    @unique       // SHA-256 hash of the full key
  keyPrefix   String                  // e.g. "pb_live_...a1b2" for display
  label       String?                 // "Production Key", "Test Key"
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  merchant    Merchant  @relation(fields: [merchantId], references: [id])
}

model PaymentIntent {
  id               String          @id @default(uuid()) @db.Uuid
  reference        String          @unique // Your internal system's order ID
  amount           Decimal         @db.Decimal(12, 2)
  currency         String          @db.VarChar(3)
  status           PaymentStatus   @default(PENDING)
  gateway          GatewayProvider
  gatewayPaymentId String?         // The external ID returned from Stripe/Paymob
  customerEmail    String
  merchantId       String          @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  merchant         Merchant        @relation(fields: [merchantId], references: [id])
  events           WebhookEvent[]
  refunds          Refund[]
}

model WebhookEvent {
  id               String          @id @default(uuid()) @db.Uuid
  paymentIntentId  String          @db.Uuid
  providerEventId  String          @unique // ID from the webhook payload (prevents replay attacks)
  payload          Json            // Store the raw webhook for audit trails
  processedAt      DateTime        @default(now())

  paymentIntent    PaymentIntent   @relation(fields: [paymentIntentId], references: [id])
}

model Refund {
  id               String          @id @default(uuid()) @db.Uuid
  paymentIntentId  String          @db.Uuid
  amount           Decimal         @db.Decimal(12, 2)
  reason           String?
  status           RefundStatus    @default(PENDING)
  gatewayRefundId  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  paymentIntent    PaymentIntent   @relation(fields: [paymentIntentId], references: [id])
}

model IdempotencyKey {
  key          String   @id
  responseBody Json?
  statusCode   Int?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}